{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "high-style-match-delivery",
  "main": "src/index.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://crossmatthew40-coder.github.io"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "high-style-match-deliveries"
    }
  ]
}
